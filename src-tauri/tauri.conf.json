{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bhatta-khata-pro",
  "version": "0.1.0",
  "identifier": "com.bukhari.bhatta-khata-pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bhatta-khata-pro",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRkVBNEI2NjFGM0JEM0MKUldROHZmTmh0cVQrMGYzNFJWMlg0dWI1YmJFTUxhL0hvZ0JEU2I1b1ZncVpEQjNvRTVINDFhbG8K",
      "endpoints": [
        "https://github.com/YOUR_GITHUB_USERNAME/bhatta-khata-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
